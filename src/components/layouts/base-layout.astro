---
import "@fontsource-variable/geist-mono/wght.css";
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/inter/wght-italic.css";
import "@fontsource-variable/lora/wght.css";
import "@fontsource-variable/lora/wght-italic.css";

import "@/styles/global.css";

import { ClientRouter } from "astro:transitions";
import { AppShell } from "@/components/app-shell";
import { Footer } from "@/components/footer";
import { Header } from "@/components/header";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: URL | string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title = "Abdul — Frontend Engineer",
  description = "Personal site of Abdul — frontend engineering, design, and writings.",
  image = "/og-image.png",
  canonicalURL = Astro.url,
  type = "website",
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://up2dul.dev");
const canonical = new URL(canonicalURL, siteUrl);
const ogImage = image.startsWith("http") ? image : new URL(image, siteUrl).href;
---

<!doctype html>
<html
  lang="en"
  class="scroll-smooth"
  transition:name="root"
  transition:animate="none"
>
  <head>
    <!-- Theme must be set before any render to prevent flash -->
    <script is:inline>
    (() => {
      function resolveTheme() {
        const stored = localStorage.getItem("theme");
        const systemDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        if (stored === "dark") return "dark";
        if (stored === "light") return "light";
        return systemDark ? "dark" : "light";
      }

      function applyToRoot(root, resolved) {
        root.classList.remove("light", "dark");
        root.classList.add(resolved);
      }

      function updateThemeColor(doc, resolved) {
        const themeColor = resolved === "dark" ? "#0a0a0a" : "#ffffff";
        doc.querySelectorAll('meta[name="theme-color"]').forEach((el) => {
          el.remove();
        });
        const meta = doc.createElement("meta");
        meta.setAttribute("name", "theme-color");
        meta.setAttribute("content", themeColor);
        doc.head.appendChild(meta);
      }

      function applyTheme(doc) {
        const resolved = resolveTheme();
        applyToRoot(doc.documentElement, resolved);
        updateThemeColor(doc, resolved);
      }

      applyTheme(document);

      if (!window.__themeSetupDone) {
        window.__themeSetupDone = true;
        document.addEventListener("astro:before-swap", (event) => {
          applyTheme(event.newDocument);
        });
      }
    })();
    </script>

    <ClientRouter />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical.href}>

    <!-- View Transitions -->
    <style is:inline>
    @keyframes fade-blur-in {
      from {
        opacity: 0;
        filter: blur(12px);
      }
      to {
        opacity: 1;
        filter: blur(0);
      }
    }

    @keyframes fade-blur-out {
      from {
        opacity: 1;
        filter: blur(0);
      }
      to {
        opacity: 0;
        filter: blur(12px);
      }
    }

    ::view-transition-old(main-content) {
      animation: fade-blur-out 0.5s ease-in-out;
    }

    ::view-transition-new(main-content) {
      animation: fade-blur-in 0.5s ease-in-out;
    }

    /* Root stays static during transitions */
    ::view-transition-group(root),
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
    </style>
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    >

    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical.href}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:type" content={type}>
    <meta property="og:site_name" content="Abdul">
    <meta property="og:locale" content="en_US">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <meta
      name="theme-color"
      content="#0a0a0a"
      media="(prefers-color-scheme: dark)"
    >
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    >

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Abdul Malik",
        url: siteUrl.href,
        jobTitle: "Frontend Engineer",
        image: ogImage,
        sameAs: [
          "https://github.com/up2dul",
          "https://x.com/up2dul",
          "https://linkedin.com/in/up2dul",
        ],
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "Abdul Malik",
        url: siteUrl.href,
        description:
          "Personal site of Abdul — frontend engineering, design, and writings.",
      })}
    />
    <!-- Umami -->
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="c6fa352f-be81-4911-866e-085161b73432"
    ></script>
  </head>
  <body
    class="flex min-h-dvh flex-col bg-background font-sans text-foreground antialiased"
  >
    <Header client:load transition:persist />
    <div id="ui-portal-root" transition:persist></div>
    <div
      transition:name="main-content"
      transition:animate="none"
      class="flex flex-1 flex-col bg-background"
    >
      <AppShell client:load>
        <main class="mx-auto w-full max-w-2xl flex-1 px-4 pt-12 pb-20">
          <slot />
        </main>
      </AppShell>
    </div>
    <Footer client:load transition:persist />
  </body>
</html>
