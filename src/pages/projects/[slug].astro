---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import { ArrowLeftIcon, ExternalLinkIcon } from "lucide-react";
import { GithubIcon } from "@/components/icons";
import { ImageLightbox } from "@/components/image-lightbox";
import BaseLayout from "@/components/layouts/base-layout.astro";
import { LinkButton } from "@/components/link-button";
import { Badge } from "@/components/ui/badge";
import { Separator } from "@/components/ui/separator";
import { formatDate } from "@/lib/date";
import { resolveProjectImage } from "@/lib/project-images";

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<BaseLayout
  title={`${data.title} | Abdul Malik`}
  description={`${data.title} — a project by Abdul Malik.`}
>
  <div class="mb-8">
    <LinkButton href="/projects" variant="outline" client:load>
      <ArrowLeftIcon aria-hidden="true" />
      Back to Projects
    </LinkButton>
  </div>

  <article class="space-y-8">
    <header class="space-y-4">
      <h1 class="text-2xl md:text-3xl">
        {data.title}
      </h1>
      <p class="text-muted-foreground">
        Accomplished in {formatDate(data.accomplishedAt)}
      </p>
      <ul class="flex flex-wrap gap-2">
        {data.technologies.map((tech) => (
            <li>
              <Badge variant="secondary">{tech}</Badge>
            </li>
          ))}
      </ul>
    </header>

    <section class="space-y-3">
      <ul class="grid gap-4 sm:grid-cols-2">
        {data.images.map((image, index) => {
          const projectImage = resolveProjectImage(image);

          return (
            projectImage && (
              <li class={index === 0 ? "sm:col-span-2" : ""}>
                <a
                  class="project-image-frame grid overflow-hidden rounded-lg outline outline-black/10 dark:outline-white/10"
                  data-project-image
                  data-lightbox-trigger
                  data-loading
                  href={projectImage.src}
                >
                  <Image
                    src={projectImage}
                    alt=""
                    aria-hidden="true"
                    width={32}
                    format="webp"
                    class="project-image-preview col-start-1 row-start-1 h-auto w-full object-cover"
                    loading={index === 0 ? "eager" : "lazy"}
                  />
                  <Image
                    src={projectImage}
                    alt={`${data.title} screenshot ${index + 1}`}
                    class="project-image-full col-start-1 row-start-1 h-auto w-full object-cover"
                    loading={index === 0 ? "eager" : "lazy"}
                  />
                </a>
              </li>
            )
          );
        })}
      </ul>
    </section>

    <div class="flex flex-wrap gap-3">
      {data.appLink && (
          <LinkButton
            href={data.appLink}
            target="_blank"
            rel="noreferrer"
            client:load
          >
            Visit App
            <ExternalLinkIcon aria-hidden="true" />
          </LinkButton>
        )}
      {data.repoLink && (
          <LinkButton
            href={data.repoLink}
            target="_blank"
            rel="noreferrer"
            variant="outline"
            client:load
          >
            <GithubIcon aria-hidden="true" />
            View Source
          </LinkButton>
        )}
    </div>

    <Separator />

    <div
      class="typeset typeset-docs space-y-4 text-pretty leading-relaxed text-foreground"
    >
      <Content />
    </div>
  </article>

  <ImageLightbox client:load />

  <noscript>
    <style is:inline>
    [data-project-image] .project-image-preview {
      display: none;
    }
    [data-project-image] .project-image-full {
      filter: none;
      opacity: 1;
    }
    </style>
  </noscript>
</BaseLayout>

<style>
.project-image-preview,
.project-image-full {
  transition:
    filter 200ms ease-out,
    opacity 200ms ease-out;
}

.project-image-preview {
  filter: blur(12px);
  transform: scale(1.04);
}

.project-image-full {
  filter: none;
  opacity: 1;
}

.project-image-frame[data-loading] .project-image-preview {
  opacity: 1;
}

.project-image-frame[data-loading] .project-image-full {
  filter: blur(8px);
  opacity: 0;
}

.project-image-frame:not([data-loading]) .project-image-preview {
  opacity: 0;
}

@media (prefers-reduced-motion: reduce) {
  .project-image-preview,
  .project-image-full {
    transition: none;
  }
}
</style>

<script is:inline data-astro-rerun>
for (const frame of document.querySelectorAll("[data-project-image]")) {
  const image = frame.querySelector(".project-image-full");
  if (!(image instanceof HTMLImageElement)) continue;

  const reveal = () => frame.removeAttribute("data-loading");

  if (image.complete && image.naturalWidth > 0) {
    reveal();
  } else {
    image.addEventListener("load", reveal, { once: true });
  }
}
</script>
