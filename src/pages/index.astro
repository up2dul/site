---
import { ArrowRightIcon, MailIcon } from "lucide-react";
import { GithubIcon, LinkedinIcon } from "@/components/icons";
import BaseLayout from "@/components/layouts/base-layout.astro";
import { LinkButton } from "@/components/link-button";
import { Separator } from "@/components/ui/separator";
import { formatDateRange } from "@/lib/date";

const experiences = [
  {
    company: "Luarsekolah",
    role: "Frontend Engineer",
    dates: { start: "2024-09-01" },
    description:
      "Revamped the main product app using Next.js, TypeScript, and Tailwind, improving Core Web Vitals from 10-33 to 60-100. Led frontend dashboard development for a B2B AI product platform.",
  },
  {
    company: "Svara",
    role: "Frontend Developer",
    dates: { start: "2023-05-01", end: "2024-08-01" },
    description:
      "Maintained and extended an internal analytics dashboard using Next.js and TypeScript. Set up GitLab CI/CD pipelines. Designed and delivered a 7-week frontend internship curriculum.",
  },
  {
    company: "Dicoding",
    role: "External Code Reviewer",
    dates: { start: "2023-04-01", end: "2026-03-01" },
    description:
      "Reviewed student submissions across several courses, provided solutions and suggestions aligned with course objectives. Supported course forums by answering technical questions.",
  },
];

const contacts = [
  { label: "Email", href: "mailto:malik301002@gmail.com", icon: MailIcon },
  { label: "GitHub", href: "https://github.com/up2dul", icon: GithubIcon },
  { label: "LinkedIn", href: "https://linkedin.com/in/up2dul", icon: LinkedinIcon },
];
---

<BaseLayout
  title="Abdul — Frontend Engineer"
  description="Abdul's personal site — frontend engineering, design, and writings."
>
  <section class="space-y-4 text-pretty">
    <div class="space-y-1">
      <h1 class="text-xl md:text-2xl">Abdul Malik</h1>
      <p class="text-muted-foreground">Frontend Engineer</p>
    </div>
    <p class="leading-relaxed">
      I'm a frontend engineer based in Indonesia with over 3 years of
      experience building accessible, performant web products. I focus on
      the UI stack — from design systems to deployment — thinking about
      both user experience and code that's maintainable.
    </p>

    <div class="flex flex-wrap gap-3">
      <LinkButton href="/cv" variant="outline" client:load>
        View CV
      </LinkButton>
      <LinkButton href="/projects" client:load>
        See My Work
        <ArrowRightIcon aria-hidden="true" />
      </LinkButton>
    </div>
  </section>

  <Separator className="my-8" />

  <section class="space-y-4">
    <h2 class="text-xl">Work Experience</h2>
    <ol class="relative border-s ps-4 md:ps-6">
      {experiences.map((experience) => (
          <li class="ms-4 mb-8 last:mb-0 md:ms-6">
            <span class="absolute -inset-s-1.5 mt-1.5 size-3 rounded-full border-2 border-background bg-muted-foreground md:-inset-s-2 md:size-4" />
            <div class="space-y-1">
              <h3 class="text-lg">{experience.role}</h3>
              <p class="text-muted-foreground">
                {experience.company} · {formatDateRange(experience.dates)}
              </p>
              <p class="text-pretty pt-1 text-muted-foreground">
                {experience.description}
              </p>
            </div>
          </li>
        ))}
    </ol>
  </section>

  <Separator className="my-8" />

  <section class="space-y-4">
    <h2 class="text-xl">Get in Touch</h2>
    <p class="text-muted-foreground">
      Open to collaborations, freelance projects, or just a friendly chat about
      frontend engineering.
    </p>
    <ul class="flex flex-wrap gap-3">
      {contacts.map((contact) => {
          const Icon = contact.icon;
          const isEmail = contact.href.startsWith("mailto");
          return (
            <li>
              <LinkButton
                href={contact.href}
                target={isEmail ? undefined : "_blank"}
                rel={isEmail ? undefined : "noreferrer"}
                variant="outline"
                size="sm"
                client:load
              >
                <Icon aria-hidden="true" className="size-4" />
                {contact.label}
              </LinkButton>
            </li>
          );
        })}
    </ul>
  </section>
</BaseLayout>
