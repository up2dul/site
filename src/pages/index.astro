---
import { Image } from "astro:assets";
import { ArrowRightIcon, ArrowUpRightIcon, FileTextIcon } from "lucide-react";
import scenery from "@/assets/scenery.webp";
import BaseLayout from "@/components/layouts/base-layout.astro";
import { LinkButton } from "@/components/link-button";
import { Separator } from "@/components/ui/separator";
import { formatYearRange } from "@/lib/date";

const experiences = [
  {
    company: "Luarsekolah",
    url: "https://luarsekolah.com",
    role: "Frontend Engineer",
    type: "Full-time",
    dates: { start: "2024-09-01" },
  },
  {
    company: "Redooceit",
    url: "https://redooceit.com",
    role: "Frontend Engineer",
    type: "Volunteer",
    dates: { start: "2025-03-01", end: "2025-06-01" },
  },
  {
    company: "Svara",
    url: "https://svara.id",
    role: "Frontend Developer",
    type: "Full-time",
    dates: { start: "2023-05-01", end: "2024-08-01" },
  },
  {
    company: "Dicoding",
    url: "https://dicoding.com",
    role: "External Code Reviewer",
    type: "Part-time",
    dates: { start: "2023-04-01", end: "2026-03-01" },
  },
];

const contacts = [
  { label: "Email", href: "mailto:hello@up2dul.dev" },
  { label: "GitHub", href: "https://github.com/up2dul", username: "up2dul" },
  { label: "𝕏 (Twitter)", href: "https://x.com/up2dul", username: "up2dul" },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/up2dul",
    username: "up2dul",
  },
];
---

<BaseLayout
  title="Abdul — Frontend Engineer"
  description="Abdul's personal site — frontend engineering, design, and writings."
>
  <section class="space-y-4 text-pretty">
    <div class="space-y-1">
      <h1 class="text-xl md:text-2xl">Abdul Malik</h1>
      <p class="text-muted-foreground">Frontend Engineer</p>
    </div>
    <p class="leading-relaxed">
      I'm a frontend engineer based in Indonesia with over 3 years of
      experience. I craft pleasant, performant, and accessible web products with
      intention, thinking about both user experience and code that's
      maintainable.
    </p>

    <div class="flex flex-wrap gap-3">
      <LinkButton href="/cv" variant="outline" client:load>
        <FileTextIcon aria-hidden="true" />
        View CV
      </LinkButton>
      <LinkButton href="/projects" client:load>
        See My Work
        <ArrowRightIcon aria-hidden="true" />
      </LinkButton>
    </div>

    <div class="relative aspect-video w-full rounded-lg overflow-hidden">
      <Image
        src={scenery}
        alt="Scenery illustration"
        class="object-cover object-bottom w-full h-full"
      />
    </div>
  </section>

  <Separator className="my-8" />

  <section class="space-y-6">
    <h2 class="text-xl">Experience</h2>
    <ul class="space-y-6">
      {experiences.map((experience) => (
          <li class="grid grid-cols-[120px_1fr] gap-4">
            <span class="text-muted-foreground text-sm">
              {formatYearRange(experience.dates)}
            </span>
            <div class="space-y-1">
              <span>{experience.role} at </span>
              <a
                href={experience.url}
                target="_blank"
                rel="noreferrer"
                class="link-hover inline-flex w-fit items-center gap-1"
              >
                {experience.company}
                <ArrowUpRightIcon aria-hidden="true" className="size-3.5" />
              </a>
              <p class="text-muted-foreground text-sm">{experience.type}</p>
            </div>
          </li>
        ))}
    </ul>
  </section>

  <Separator className="my-8" />

  <section class="space-y-6">
    <h2 class="text-xl">Contact</h2>
    <ul class="space-y-3">
      {contacts.map((contact) => {
          const isEmail = contact.href.startsWith("mailto");
          return (
            <li class="grid grid-cols-[120px_1fr] gap-4">
              <span class="text-muted-foreground text-sm">{contact.label}</span>
              <a
                href={contact.href}
                target={isEmail ? undefined : "_blank"}
                rel={isEmail ? undefined : "noreferrer"}
                class="link-hover inline-flex w-fit items-center gap-1"
              >
                {contact.username ?? contact.href.replace("mailto:", "")}
                <ArrowUpRightIcon aria-hidden="true" className="size-3.5" />
              </a>
            </li>
          );
        })}
    </ul>
  </section>
</BaseLayout>
